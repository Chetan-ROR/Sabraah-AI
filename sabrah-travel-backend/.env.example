APP_NAME=Sabrah Travel Backend
APP_ENV=development

HOST=127.0.0.1
PORT=8001

API_KEY=local-development-key

# mock = local trains.json | real = Super Travel api-repository live train list
TRAIN_PROVIDER=real
FLIGHT_PROVIDER=real
BUS_PROVIDER=mock
HOTEL_PROVIDER=mock
PACKAGE_PROVIDER=mock

SUPER_TRAVEL_API_BASE_URL=http://127.0.0.1:8002
SUPER_TRAVEL_TIMEOUT_SECONDS=20
SUPER_TRAVEL_FLIGHT_TIMEOUT_SECONDS=60
TRAIN_PROVIDER_FALLBACK_MOCK=true
FLIGHT_PROVIDER_FALLBACK_MOCK=true

LOG_LEVEL=INFO
